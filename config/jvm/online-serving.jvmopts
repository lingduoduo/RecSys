# online-serving — Armeria Online Prediction Server, G1GC (port 7010)
#
# Workload: real-time feature scoring + candidate ranking; objects are small and
# short-lived. Similar heap profile to recsys-serving.

# ── 堆 (Heap) ─────────────────────────────────────────────────────────────────
-Xms1g
-Xmx2g

# ── G1 collector ──────────────────────────────────────────────────────────────
-XX:+UseG1GC
-XX:G1HeapRegionSize=4m
-XX:MaxGCPauseMillis=100

# ── 新生代比例 ────────────────────────────────────────────────────────────────
-XX:+UnlockExperimentalVMOptions
-XX:G1NewSizePercent=20
-XX:G1MaxNewSizePercent=40

# ── IHOP / mixed-GC ───────────────────────────────────────────────────────────
-XX:+G1UseAdaptiveIHOP
-XX:InitiatingHeapOccupancyPercent=40
-XX:G1ReservePercent=15
-XX:G1MixedGCCountTarget=8
-XX:G1MixedGCLiveThresholdPercent=85

# ── 其他 ──────────────────────────────────────────────────────────────────────
-XX:+UseStringDeduplication
-Xss256k
-XX:MetaspaceSize=96m
-XX:MaxMetaspaceSize=192m

# ── Logging / diagnostics ─────────────────────────────────────────────────────
-Xlog:gc+heap=debug,gc+phases=debug,gc+humongous=debug,safepoint=info:file=logs/gc-online-serving.log:time,uptime,level:filecount=5,filesize=20m
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=logs/heap-dump-online-serving.hprof
