# recsys-serving-zgc — Jetty Recommendation Serving API, ZGC (port 6010)
# Requires Java 21+. Use for sub-10 ms pause SLO on the recommendation path.

# ── 堆 (Heap) ─────────────────────────────────────────────────────────────────
-Xms1g
-Xmx3g

# ── ZGC (Java 21 Generational ZGC) ───────────────────────────────────────────
-XX:+UseZGC
-XX:+ZGenerational
-XX:ZCollectionInterval=5
-XX:ZUncommitDelay=300
# -XX:ConcGCThreads=4

# ── 其他 ──────────────────────────────────────────────────────────────────────
-Xss256k
-XX:MetaspaceSize=96m
-XX:MaxMetaspaceSize=192m

# ── Logging / diagnostics ─────────────────────────────────────────────────────
-Xlog:gc*,safepoint=info:file=logs/gc-recsys-serving-zgc.log:time,uptime,level:filecount=5,filesize=20m
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=logs/heap-dump-recsys-serving-zgc.hprof
