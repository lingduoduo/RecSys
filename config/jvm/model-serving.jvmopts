# Spring Boot model serving service (Tomcat + ONNX Runtime, port 8080)
#
# JVM memory model mapping:
# - Heap: feature config, item embeddings, request DTOs, recommendation cache.
# - Thread stacks: Tomcat worker threads and model-serving call frames.
# - Metaspace/method area: Spring Boot, validation, Jackson, ONNX Runtime bindings.
# - Native/direct memory: ONNX Runtime native buffers and limited direct allocation.
-Xms512m
-Xmx1536m
-Xss512k
-XX:MaxMetaspaceSize=384m
-XX:ReservedCodeCacheSize=160m
-XX:MaxDirectMemorySize=512m
-XX:+UseG1GC
-XX:MaxGCPauseMillis=100
-XX:+UseStringDeduplication
-XX:+AlwaysPreTouch
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=logs/model-serving.hprof
-XX:ErrorFile=logs/hs_err_model-serving_pid%p.log
-Xlog:gc*,safepoint:file=logs/gc-model-serving-%p.log:time,uptime,level,tags:filecount=5,filesize=20M
