# model-serving-zgc — Spring Boot ONNX inference service, ZGC (port 8080)
# Requires Java 21+. Use when p99 inference latency is dominated by GC pauses.
#
# ZGC STW pauses are < 1 ms. Tradeoff: ~15 % more CPU for concurrent GC work.
# Monitor allocationStalls in GET /health/gc; if > 0, add ConcGCThreads or Xmx.

# ── 堆 (Heap) ─────────────────────────────────────────────────────────────────
# Xms == Xmx: avoids heap-growth pauses under load.
# ZGC requires 25–50 % headroom for concurrent relocation.
-Xms2g
-Xmx4g

# ── ZGC (Java 21 Generational ZGC) ───────────────────────────────────────────
-XX:+UseZGC
-XX:+ZGenerational

# Proactive cycle every 5 s: prevents old-gen spike when a burst arrives.
-XX:ZCollectionInterval=5

# Release uncommitted pages to OS after 5 min of disuse.
-XX:ZUncommitDelay=300

# Concurrent GC threads: default ncpu/4. Uncomment and tune if allocationStalls > 0.
# -XX:ConcGCThreads=4

# ── 其他 ──────────────────────────────────────────────────────────────────────
-Xss256k
-XX:MetaspaceSize=128m
-XX:MaxMetaspaceSize=256m

# ── Logging / diagnostics ─────────────────────────────────────────────────────
-Xlog:gc*,safepoint=info:file=logs/gc-model-serving-zgc.log:time,uptime,level:filecount=5,filesize=20m
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=logs/heap-dump-model-serving-zgc.hprof
