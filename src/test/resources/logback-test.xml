<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Suppress expected connection-failure WARNs from Lettuce client construction in tests -->
  <logger name="io.lettuce.core" level="ERROR"/>

  <!-- Negative-path tests deliberately inject failures (Mockito thenThrow / fake doubles) to prove
       these classes degrade gracefully; the handled failure is logged at WARN. Mute it so a green
       run stays clean. These are scoped to specific classes, not whole packages, so real warnings
       still surface. -->
  <logger name="com.recsys.application.experiment.AbExposureLogger" level="ERROR"/>
  <logger name="com.recsys.application.experiment.VariantRuntimeResolver" level="ERROR"/>
  <logger name="com.recsys.application.online.LearnerFlushScheduler" level="ERROR"/>

  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
