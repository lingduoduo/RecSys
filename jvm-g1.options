# G1GC tuning profile — RecSys backend service (enhanced G1)
#
# When to choose this profile over jvm.options:
#   Use when you need phase-level GC logging, adaptive IHOP diagnostics, or are
#   actively tuning mixed-GC frequency and live-threshold on a production replica.
#   For out-of-the-box use, jvm.options is the simpler starting point.
#
# Workload model:
#   Heap dominated by float[] embedding cache in old gen (~50 MB) and
#   short-lived inference arrays (float[], Map) in young gen.
#   G1 mixed collections reclaim old-gen slots incrementally, avoiding
#   Full GC in normal operation.
#
# Usage:
#   java $(cat jvm-g1.options) -jar recsys-api-*.jar

# ── 堆 (Heap) ─────────────────────────────────────────────────────────────────
# Fixed heap: eliminates GC-triggered expansion pauses and OS page-fault stalls.
-Xms2g
-Xmx2g

# ── G1 collector ──────────────────────────────────────────────────────────────
-XX:+UseG1GC

# 4 MB regions: right-sized for float[128] = 512 B vectors (well below the
# humongous threshold of 2 MB = half region).
# Raise to 8 MB if embeddings exceed 512 dims (float[512] = 2 KB → still safe).
-XX:G1HeapRegionSize=4m

# Soft STW pause target. G1 is probabilistic; bursts may still exceed this.
# Lower to 50 ms only if your p99 SLO is tighter; expect more frequent minor GC.
-XX:MaxGCPauseMillis=100

# ── 新生代比例 (Young generation sizing) ──────────────────────────────────────
# G1 adapts Eden size each collection to stay within MaxGCPauseMillis.
#
# Floor 20 % = 400 MB: prevents excessive minor GC frequency under high request
#   allocation (JSON + float[] inference arrays at 100–1 000 req/s).
# Ceiling 40 % = 800 MB: leaves ≥1.2 g for old-gen embedding + recommendation
#   caches, preventing promotion-driven Full GC.
#
# Tuning guide: if /health/gc shows MINOR_GC avgPauseMs close to 100 ms, widen
# G1MaxNewSizePercent by 5 %; if promoted bytes/s > 50 MB/s, shrink the floor.
-XX:+UnlockExperimentalVMOptions
-XX:G1NewSizePercent=20
-XX:G1MaxNewSizePercent=40

# ── IHOP / mixed-GC policy ────────────────────────────────────────────────────
# Adaptive IHOP (Java 12+): JVM auto-tunes the old-gen marking trigger from
# observed allocation and promotion rates. Seed is the static IHOP below.
-XX:+G1UseAdaptiveIHOP
# 40 % = 800 MB on 2 g heap. Triggers concurrent mark early enough that mixed
# collections keep up with promotion rate; raise to 50 % if mixed GC is too
# frequent at steady state.
-XX:InitiatingHeapOccupancyPercent=40

# Emergency reserve: 15 % of old gen (≈ 240 MB) kept free for evacuation spikes.
# Without this, a sudden promotion burst after IHOP fires can force a Full GC.
-XX:G1ReservePercent=15

# Up to 8 mixed-GC rounds per concurrent-mark cycle. Lower = reclaim old gen
# faster (good for bursty eviction); higher = fewer mixed GCs (better throughput).
-XX:G1MixedGCCountTarget=8

# Reclaim old-gen regions with ≤85 % live data. Raise to collect more per round
# at the cost of longer per-round pause; lower to be more selective.
-XX:G1MixedGCLiveThresholdPercent=85

# ── GC threads ────────────────────────────────────────────────────────────────
# STW GC threads (default = min(ncpu, 8)). Uncomment and set to vCPU count if
# minor GC pauses are longer than MaxGCPauseMillis on a high-core-count host.
# -XX:ParallelGCThreads=8
#
# Concurrent marking threads (default = ParallelGCThreads / 4, min 1).
# Increase if /health/gc shows Full GC events or rising old-gen occupancy while
# concurrent mark is still running.
# -XX:ConcGCThreads=4

# ── 其他 (Other) ───────────────────────────────────────────────────────────────
-XX:+UseStringDeduplication

# ── 栈 (Stack) ────────────────────────────────────────────────────────────────
# Serving path is shallow (HTTP → controller → ONNX → Redis); 256 KB is ample.
-Xss256k

# ── 元空间 (Metaspace) ────────────────────────────────────────────────────────
# Spring Boot 3 + ONNX Runtime ≈ 8–10 K classes.
-XX:MetaspaceSize=128m
-XX:MaxMetaspaceSize=256m

# ── GC logging ────────────────────────────────────────────────────────────────
# gc+heap=debug  : before/after heap sizes — tracks Minor vs Full
# gc+phases=debug: G1 phase breakdown (young, mixed, cleanup, remark)
# gc+humongous   : log humongous allocations — first sign of region-size mistuning
# safepoint=info : STW safepoint times — catches non-GC STW pauses
-Xlog:gc+heap=debug,gc+phases=debug,gc+humongous=debug,safepoint=info:file=gc-g1.log:time,uptime,level:filecount=5,filesize=20m

# ── Diagnostics ───────────────────────────────────────────────────────────────
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=heap-dump-g1.hprof
-XX:+PrintFlagsFinal
