# Java / Maven
*.class
target/
**/target/

# Packaged artifacts
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Logs and runtime output
*.log
logs/
*.pid

# Python local environments
.venv/
__pycache__/
*.py[cod]

# Model artifacts — large binary files exported by external pipelines, not bundled in the JAR
src/main/resources/artifacts/

# Local configuration / secrets
.env
.env.*
!.env.example

# IDEs and editors
.vscode/
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# OS files
.DS_Store
Thumbs.db

# BlueJ
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# JVM crash logs
hs_err_pid*
replay_pid*

# Local isolated feature worktrees
.worktrees/

# understand-anything generated analysis (regenerable; a committed snapshot goes
# stale within days and then makes claims about code that has since changed).
# .understandignore stays tracked — it is the one file here a human would edit.
.understand-anything/*.json
