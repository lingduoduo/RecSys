# Java / Maven
*.class
target/
**/target/

# Packaged artifacts
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Logs and runtime output
*.log
logs/
*.pid

# Python local environments
.venv/
__pycache__/
*.py[cod]

# Model artifacts — large binary files exported by external pipelines, not bundled in the JAR.
#
# EXCEPT the per-variant feature configs. Those are ~380 bytes of JSON (vocab maps plus a
# model_file pointer), not pipeline binaries, and the serving path CANNOT START without them:
# ModelArtifactService.loadFeatureConfig throws when
# artifacts/model/<variant>/feature_config.json is missing. While the blanket rule hid them,
# InferenceLoadTest could never pass on a fresh checkout — it only worked on machines where
# someone had generated them locally, and that went unnoticed for as long as the scheduled
# workflow that runs it was itself broken (#260). The ONNX model they point at
# (dssm_model.onnx) is already committed at the resources root.
#
# Written as a descend-ladder rather than a plain negation: git never looks inside an excluded
# DIRECTORY, so re-including a nested file requires excluding each level's *contents* while
# leaving the directory itself traversable.
src/main/resources/artifacts/*
!src/main/resources/artifacts/model/
src/main/resources/artifacts/model/*
!src/main/resources/artifacts/model/*/
src/main/resources/artifacts/model/*/*
!src/main/resources/artifacts/model/*/feature_config.json

# Local configuration / secrets
.env
.env.*
!.env.example

# IDEs and editors
.vscode/
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# OS files
.DS_Store
Thumbs.db

# BlueJ
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# JVM crash logs
hs_err_pid*
replay_pid*

# Local isolated feature worktrees
.worktrees/

# understand-anything generated analysis (regenerable; a committed snapshot goes
# stale within days and then makes claims about code that has since changed).
# .understandignore stays tracked — it is the one file here a human would edit.
.understand-anything/*.json

# promtool cannot parse the PrometheusRule CRD envelope (apiVersion/kind/metadata/spec)
# around k8s/base/prometheus-rules.yaml, so `promtool check rules` and
# `promtool test rules` both run against this bare-format copy of its `.spec`, generated
# on demand via `yq '.spec' prometheus-rules.yaml`. Never hand-edit or commit it — see
# k8s/base/prometheus-rules.test.yaml for the regeneration command.
k8s/base/prometheus-rules.rules.yaml

# Redis snapshot written into the repo root by a locally-booted redis-server. Every
# service verification here starts one (see docs/runbooks/overload-protection.md and the
# local-run notes in the README), so it reappears after any smoke check. Regenerable and
# machine-local; committing it would put a binary keyspace dump in the history.
dump.rdb
