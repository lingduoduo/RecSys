<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.recsys</groupId>
  <artifactId>recsys-api</artifactId>
  <version>1.0-SNAPSHOT</version>

  <properties>
    <!-- Spark 3.5 runs reliably on Java 17 LTS. -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.3.4</spring-boot.version>
    <onnxruntime.version>1.18.0</onnxruntime.version>
    <armeria.version>1.28.4</armeria.version>
    <aws.sdk.version>2.25.70</aws.sdk.version>
    <flyway.version>10.20.1</flyway.version>
    <!-- Default: skip @Tag("load") and @Tag("docker") tests.
         Override: mvn test -DexcludedGroups="" -Dgroups=load
         Run docker tests: mvn test -DexcludedGroups=load -->
    <excludedGroups>load,docker</excludedGroups>
  </properties>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Include .txt data files that live alongside source code -->
      <resource>
        <directory>src/main/java</directory>
        <includes>
          <include>**/*.txt</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>enforce-build-invariants</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <dependencyConvergence/>
                <requireJavaVersion>
                  <version>[17,18)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <excludes>
            <exclude>com/recsys/training/rulebased/**</exclude>
            <exclude>com/recsys/online/flink/**</exclude>
          </excludes>
          <!-- Mirror the main-source exclusions so flink test classes don't fail
               to compile in the default (non streaming-flink) profile. -->
          <testExcludes>
            <testExclude>com/recsys/online/flink/**</testExclude>
          </testExcludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- ONNX Runtime appends to the bootstrap classpath, which disables CDS and triggers this warning.
               Disabling CDS upfront suppresses it cleanly. -->
          <argLine>-Xshare:off --add-opens=java.base/java.util=ALL-UNNAMED -Dapi.version=1.44</argLine>
          <!-- Load tests are opt-in: mvn test -Dgroups=load
               Normal test runs skip them to keep CI fast. -->
          <excludedGroups>${excludedGroups}</excludedGroups>
          <!-- Colima (macOS) exposes the Docker daemon at a non-standard socket path.
               Testcontainers needs the socket override to mount it correctly, and Ryuk
               must be disabled because Colima's VM cannot bind-mount the host socket path. -->
          <environmentVariables>
            <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
            <TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>/var/run/docker.sock</TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>
          </environmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <mainClass>com.recsys.api.rest.ModelApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <!-- Caffeine: concurrent, bounded, stats-recording in-heap cache for the embedding hot path. -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
      <version>3.1.8</version>
    </dependency>
    <!-- HikariCP: connection pool for the optional MySQL client. -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>5.1.0</version>
    </dependency>
    <!-- Armeria HTTP/2 server. -->
    <dependency>
      <groupId>com.linecorp.armeria</groupId>
      <artifactId>armeria</artifactId>
      <version>${armeria.version}</version>
    </dependency>
    <dependency>
      <groupId>com.linecorp.armeria</groupId>
      <artifactId>armeria-junit5</artifactId>
      <version>${armeria.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Spring Boot service for the two-tower ONNX serving demo. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>

    <!-- ONNX Runtime for Java user-tower inference. -->
    <dependency>
      <groupId>com.microsoft.onnxruntime</groupId>
      <artifactId>onnxruntime</artifactId>
      <version>${onnxruntime.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <version>${spring-boot.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Lettuce (Redis client) -->
    <dependency>
      <groupId>io.lettuce</groupId>
      <artifactId>lettuce-core</artifactId>
      <version>6.3.2.RELEASE</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
      <version>2.12.0</version>
    </dependency>

    <!-- Optional MySQL support. Loaded only when code opens a JDBC connection. -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.4.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <version>${flyway.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
      <version>${flyway.version}</version>
    </dependency>

    <!-- Testcontainers for Redis integration tests. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>kafka</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Micrometer Prometheus exporter for Armeria metrics -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus-simpleclient</artifactId>
    </dependency>

    <!-- Kafka client for KafkaAsyncEventPublisher transport; MockProducer ships in this artifact.
         Version pinned explicitly — Spring Boot BOM is not imported in this pom's dependencyManagement. -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>3.7.1</version>
    </dependency>

    <!-- AWS SDK v2 SQS transport for AsyncEventPublisher and saga event publishing. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sqs</artifactId>
      <version>${aws.sdk.version}</version>
    </dependency>

  </dependencies>

  <dependencyManagement>
    <!-- Pin Jackson to Spring Boot's version so Testcontainers/docker-java
         cannot downgrade jackson-annotations to 2.10.x (which lacks JsonIncludeProperties).
         Pin slf4j-api to 2.x so Armeria's transitive 1.7.36 cannot override Spring Boot 3/Logback 1.5. -->
    <dependencies>
      <!-- Align the transport family to Armeria and AWS SDK's shared Netty line. -->
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>4.1.108.Final</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Align Jackson and Micrometer families to Spring Boot 3.3.4's versions. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.17.2</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-bom</artifactId>
        <version>1.13.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>1.20.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-annotations</artifactId>
        <version>2.17.2</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>2.17.2</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>2.17.2</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>2.0.16</version>
      </dependency>
      <dependency>
        <groupId>commons-codec</groupId>
        <artifactId>commons-codec</artifactId>
        <version>1.15</version>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-core</artifactId>
        <version>1.13.4</version>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-registry-prometheus-simpleclient</artifactId>
        <version>1.13.4</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <profiles>
    <profile>
      <id>resilience</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/resilience/*Test.java</include>
                <include>**/loadshed/*Test.java</include>
                <include>**/ratelimit/RedisRateLimiterTest.java</include>
                <include>**/retrieval/multichannel/*DegradationTest.java</include>
                <include>**/retrieval/multichannel/*BulkheadTest.java</include>
                <include>**/outbox/OutboxRelayTest.java</include>
                <include>**/outbox/OutboxRetryPolicyTest.java</include>
                <include>**/saga/*OrchestratorTest.java</include>
                <include>**/*DegradedHeaderTest.java</include>
                <include>**/redis/ShardedTopKStoreTest.java</include>
                <include>**/redis/ShardedTopKStoreTtlConfigTest.java</include>
                <include>**/cache/LogicalExpiryEmbeddingCacheTest.java</include>
                <include>**/cache/MultiLevelEmbeddingCacheTest.java</include>
                <include>**/sharding/SequenceGeneratorGenerationTest.java</include>
                <include>**/sharding/ShardKeysTest.java</include>
                <include>**/sharding/ShardTopologySnapshotFormatTest.java</include>
                <include>**/sharding/ShardedRecordStoreAtomicWriteTest.java</include>
                <include>**/sharding/ShardedRecordStoreMergeTest.java</include>
                <include>**/sharding/ShardTopologyProviderTest.java</include>
                <include>**/sharding/ShardCursorKindTest.java</include>
                <include>**/store/ShardedRecordServiceCursorTest.java</include>
                <include>**/redis/LettuceRedisExecutorPipelineTest.java</include>
                <include>**/redis/RedisEmbeddingStoreTest.java</include>
                <include>**/redis/RedisEvictionPolicyManifestTest.java</include>
                <include>**/redis/RedisCacheStatsProbeTest.java</include>
                <include>**/redis/RedisPersistentKeyProbeTest.java</include>
                <include>**/redis/RedisReplicaLagProbeTest.java</include>
                <include>**/metrics/RedisCacheMetricsTest.java</include>
                <include>**/metrics/SplunkHecMetricsTest.java</include>
                <include>**/metrics/ScrapeTargetManifestTest.java</include>
                <!-- The egress counterpart to ScrapeTargetManifestTest's ingress checks. The
                     NetworkPolicy is the L3/L4 ACL the whole backend trust model rests on
                     (20_AuthN_AuthZ), and its failure mode is silence: a dropped egress rule
                     looks like a dependency outage, not a policy bug. Pure file parsing. -->
                <include>**/k8s/NetworkPolicyEgressManifestTest.java</include>
                <include>**/k8s/UpstreamTest.java</include>
                <!-- These two are the producer half of the data-freshness alerts.
                     ScrapeTargetManifestTest above proves the series get collected;
                     ConsistencyMetricsTest pins the exact scraped text those alerts
                     select on (a Timer is exposed as _max, never as its meter name), and
                     RedisFeatureVersionSamplerTest pins the availability semantics that
                     stop a frozen age gauge from reading as fresh. Without both in the
                     gate, a Micrometer upgrade could rename the series and silently
                     disarm every alert in the recsys.data group without failing a PR. -->
                <include>**/metrics/ConsistencyMetricsTest.java</include>
                <include>**/redis/RedisFeatureVersionSamplerTest.java</include>
                <include>**/observability/SplunkHecConfigTest.java</include>
                <include>**/observability/SplunkHecEventSerializerTest.java</include>
                <include>**/observability/SplunkHecClientTest.java</include>
                <include>**/observability/SplunkHecAppenderTest.java</include>
                <include>**/observability/SplunkLogbackWiringTest.java</include>
                <include>**/serving/EmbeddingSeedRepairTest.java</include>
                <include>**/serving/CacheKeyParamTest.java</include>
                <include>**/serving/CatalogCacheHeadersTest.java</include>
                <include>**/serving/SimilarCacheHeadersTest.java</include>
                <!-- Not resilience tests. This profile is what the PR gate runs
                     (.github/workflows/resilience-pr.yml), so it is the only place a
                     deterministic check can block a merge. Everything listed here is pure
                     unit-level — no Redis, no Docker, no timing — so it is safe. Note that
                     @Tag("docker") tests are excluded by <excludedGroups> below regardless
                     of any <include> above, so listing one would imply coverage the gate
                     does not actually provide. -->
                <include>**/docs/DocumentationIndexTest.java</include>
                <include>**/docs/DocumentedMechanismTest.java</include>
              </includes>
              <excludedGroups>load,docker</excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>offline-embedding</id>
      <dependencies>
        <!-- Offline item embedding training with Spark ML Word2Vec. -->
        <dependency>
          <groupId>org.apache.spark</groupId>
          <artifactId>spark-sql_2.12</artifactId>
          <version>3.5.1</version>
          <scope>provided</scope>
        </dependency>

        <dependency>
          <groupId>org.apache.spark</groupId>
          <artifactId>spark-mllib_2.12</artifactId>
          <version>3.5.1</version>
          <scope>provided</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.13.0</version>
            <configuration>
              <!-- Compile only the Spark offline-embedding job (training/rulebased).
                   Keep the Flink sources excluded — this profile has no Flink deps. -->
              <excludes combine.self="override">
                <exclude>com/recsys/online/flink/**</exclude>
              </excludes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>streaming-flink</id>
      <dependencies>
        <dependency>
          <groupId>org.apache.flink</groupId>
          <artifactId>flink-java</artifactId>
          <version>1.18.1</version>
        </dependency>
        <dependency>
          <groupId>org.apache.flink</groupId>
          <artifactId>flink-streaming-java</artifactId>
          <version>1.18.1</version>
        </dependency>
        <dependency>
          <groupId>org.apache.flink</groupId>
          <artifactId>flink-streaming-java</artifactId>
          <version>1.18.1</version>
          <type>test-jar</type>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.apache.flink</groupId>
          <artifactId>flink-runtime</artifactId>
          <version>1.18.1</version>
          <type>test-jar</type>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.apache.flink</groupId>
          <artifactId>flink-core</artifactId>
          <version>1.18.1</version>
          <type>test-jar</type>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.apache.flink</groupId>
          <artifactId>flink-test-utils-junit</artifactId>
          <version>1.18.1</version>
          <scope>test</scope>
          <exclusions>
            <exclusion>
              <groupId>*</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.apache.flink</groupId>
          <artifactId>flink-clients</artifactId>
          <version>1.18.1</version>
        </dependency>
        <dependency>
          <groupId>org.apache.flink</groupId>
          <artifactId>flink-connector-kafka</artifactId>
          <version>3.2.0-1.18</version>
        </dependency>
        <dependency>
          <groupId>org.apache.flink</groupId>
          <artifactId>flink-statebackend-rocksdb</artifactId>
          <version>1.18.1</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.13.0</version>
            <configuration>
              <excludes combine.self="override">
                <exclude>com/recsys/training/rulebased/**</exclude>
              </excludes>
              <!-- Clear the default testExcludes so flink test classes compile. -->
              <testExcludes combine.self="override"/>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
